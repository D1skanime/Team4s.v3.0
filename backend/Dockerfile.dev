FROM golang:1.25-alpine

ARG AIR_VERSION=v1.65.3

# The backend image pipeline uses pure-Go imaging. FFmpeg/FFprobe remain
# available so prepared segment flows behave like the production runtime.
# vips-tools (D-21): CLI vipsthumbnail, used to generate animated WebP/GIF "display" variants
# that keep every frame (ffmpeg cannot decode animated WebP; x/image/webp cannot decode ANMF
# frames at all) -- this is the vipsthumbnail CLI binary, distinct from the vips/vips-dev shared
# libraries used by the production Dockerfile for govips CGO bindings.
# fontconfig + Fallback-Fonts: ohne Systemschriften rendert libass ASS-Untertitel unsichtbar.
RUN apk add --no-cache ffmpeg vips-tools fontconfig font-dejavu font-noto font-noto-cjk \
    && go install github.com/air-verse/air@${AIR_VERSION}

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

# Compose Watch synchronizes later edits into this native Linux filesystem.
# Keeping the source in the image avoids slow Go builds across a Windows bind mount.
COPY . .

CMD ["air", "-c", ".air.toml"]
